# Conductor Sprint 6d -- Google ADK harness
# Copy to .env and fill in real values. Never commit .env.

# LLM Gateway (required -- for both the agent itself AND eval/judge.py). No separate
# GOOGLE_API_KEY: this gateway is a multi-provider proxy (confirmed live -- Gemini is
# one of ~100 models it serves under the same key), so GatewayGemini in src/agent.py
# routes Gemini calls through this same URL/key instead of Google AI Studio directly.
LLM_GATEWAY_URL=https://your-gateway-host
ANTHROPIC_API_KEY=your-gateway-api-key-here

# Model (optional -- defaults to gemini-pro-latest, the gateway's slug for Gemini Pro,
# chosen for Standard-tier parity with claude-sonnet-4-5)
# CONDUCTOR_MODEL=gemini-pro-latest

# Secrets backend (choose one)
# Vault: set all four; SecretStore will use Vault when VAULT_ADDR + VAULT_TOKEN are set
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=your-vault-token-here
VAULT_MOUNT=secret
VAULT_PATH_PREFIX=conductor

# Memory backend
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=conductor_memory

# Redis session cache (Layer 1 -- separate from memory store)
REDIS_URL=redis://localhost:6379/0

# Catalog base URL for connector config tools
CATALOG_BASE_URL=https://your-catalog-host

# Path allowlist for the before_tool_callback path guard (RULE-ADK02)
# CONDUCTOR_ALLOWED_ROOT=/absolute/path/to/allowed/dir
