# Conductor Sprint 6a -- LangGraph harness
# Copy to .env and fill in real values. Never commit .env.

# LLM Gateway (required)
LLM_GATEWAY_URL=https://your-gateway-host/v1
ANTHROPIC_API_KEY=your-gateway-api-key-here

# Secrets backend (choose one)
# Vault: set all four; SecretStore will use Vault when VAULT_ADDR + VAULT_TOKEN are set
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=your-vault-token-here
VAULT_MOUNT=secret
VAULT_PATH_PREFIX=conductor

# Memory backend
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=conductor_memory

# Redis session cache (Layer 1 -- separate from memory store)
REDIS_URL=redis://localhost:6379/0

# Catalog base URL for connector config tools
CATALOG_BASE_URL=https://your-catalog-host

# SQLite checkpoint path (RULE-LG02). Default: conductor_checkpoints.db
# CONDUCTOR_DB_PATH=conductor_checkpoints.db
